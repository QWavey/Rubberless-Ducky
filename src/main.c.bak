/**
 * @file main.c
 * @brief Custom HID Firmware for AT32UC3B1 (AVR32 UC3B1256)
 *
 * Fully self-contained — uses only avr32/io.h register definitions.
 * Verified register names against UC3B1256 peripheral headers:
 *   pm_230.h, tc_222.h, flashc_200.h, intc_101.h
 *
 * Toolchain: AVR32 GNU Toolchain 3.2.3
 */

#include <avr32/io.h>
#include <stdint.h>
#include <stdbool.h>
#include <string.h>

#include "usb_hid.h"
#include "usb_descriptors.h"

/* Custom basic string functions for freestanding/nostdlib environment */
void *memcpy(void *dest, const void *src, size_t n) {
    char *d = dest;
    const char *s = src;
    while (n--) {
        *d++ = *s++;
    }
    return dest;
}

void *memset(void *s, int c, size_t n) {
    char *p = s;
    while (n--) {
        *p++ = (char)c;
    }
    return s;
}

/* -----------------------------------------------------------------------
 * Low-level system macros and interrupt configuration helpers
 * --------------------------------------------------------------------- */
#ifndef AVR32_PM_PBAMASK_TC_OFFSET
#define AVR32_PM_PBAMASK_TC_OFFSET    (AVR32_TC_CLK_PBA - 64)
#endif

#define Enable_global_interrupt()  __asm__ __volatile__ ("csrf 16")
#define Disable_global_interrupt() __asm__ __volatile__ ("ssrf 16")

/* Simple busy-wait delay — calibrated for 48 MHz CPU clock.
 * At 48 MHz, 1 ms ≈ 48000 cycles. With loop overhead ~4 cycles/iter:
 * iterations_per_ms = 48000 / 4 = 12000.
 * Used only during startup/payload; USB task is also called inside. */
#define CYCLES_PER_MS  12000u

/* -----------------------------------------------------------------------
 * GPIO helpers — raw register access via avr32_gpio_port_t
 * UC3B1: PORTA=0 (GPIO0-31), PORTB=1 (GPIO32-63)
 * PB00 = port 1, pin 0  |  PB01 = port 1, pin 1
 * Adjust these two defines to match your board's LED pin.
 * --------------------------------------------------------------------- */
#define LED_PORT    0       /* PORTA */
#define LED_PIN     1       /* PA01 (Red) */
#define BTN_PORT    1       /* PORTB */
#define BTN_PIN     1       /* PB01  */

#define _GPIO_PORT(n)  ((volatile avr32_gpio_port_t *)(AVR32_GPIO_ADDRESS + (n)*sizeof(avr32_gpio_port_t)))

static inline void gpio_out(int port, int pin)
{
    volatile avr32_gpio_port_t *p = _GPIO_PORT(port);
    p->gpers = (1u << pin);   /* GPIO control   */
    p->oders = (1u << pin);   /* Output enable  */
}

static inline void gpio_in_pullup(int port, int pin)
{
    volatile avr32_gpio_port_t *p = _GPIO_PORT(port);
    p->gpers = (1u << pin);   /* GPIO control   */
    p->oderc = (1u << pin);   /* Output disable */
    p->puers = (1u << pin);   /* Pull-up enable */
}

static inline void gpio_high(int port, int pin) { _GPIO_PORT(port)->ovrs = (1u << pin); }
static inline void gpio_low (int port, int pin) { _GPIO_PORT(port)->ovrc = (1u << pin); }
static inline bool gpio_read(int port, int pin) { return !!(_GPIO_PORT(port)->pvr & (1u << pin)); }

/* -----------------------------------------------------------------------
 * HID Keyboard Report format
 * --------------------------------------------------------------------- */
#define HID_REPORT_SIZE 8

typedef struct {
    uint8_t modifier;
    uint8_t reserved;
    uint8_t keys[6];
} keyboard_report_t;

/* Modifier masks */
#define MOD_LCTRL   0x01
#define MOD_LSHIFT  0x02
#define MOD_LALT    0x04
#define MOD_LGUI    0x08
#define MOD_RCTRL   0x10
#define MOD_RSHIFT  0x20
#define MOD_RALT    0x40
#define MOD_RGUI    0x80

/* Key codes */
#define KEY_R       0x15
#define KEY_ENTER   0x28
#define KEY_N       0x11
#define KEY_O       0x12
#define KEY_T       0x17
#define KEY_E       0x08
#define KEY_P       0x13
#define KEY_A       0x04
#define KEY_D       0x07

/* -----------------------------------------------------------------------
 * Global state
 * --------------------------------------------------------------------- */
static volatile bool     g_usb_ready  = false;
static volatile uint32_t g_tick_ms   = 0;
static          bool     g_led       = false;

/* -----------------------------------------------------------------------
 * USB callbacks
 * --------------------------------------------------------------------- */
void usb_device_enumerated_cb(void)
{
    g_usb_ready = true;
    gpio_low(LED_PORT, LED_PIN); /* ON (active low) */
    g_led = true;
}

void usb_hid_report_out_cb(uint8_t *data, uint8_t length)
{
    /* Keyboard LED states received from host via SET_REPORT */
    if (length > 0) {
        uint8_t leds = data[0];
        /* NumLock = bit 0, CapsLock = bit 1, ScrollLock = bit 2 */
        if (leds & 0x02) {
            gpio_low(LED_PORT, LED_PIN); /* Turn on Red LED if Caps Lock is ON */
        } else {
            gpio_high(LED_PORT, LED_PIN); /* Turn off Red LED if Caps Lock is OFF */
        }
    }
}

/* -----------------------------------------------------------------------
 * Tick counter — incremented by delay_ms, polled by the app
 * --------------------------------------------------------------------- */

/* -----------------------------------------------------------------------
 * Keyboard helpers
 * --------------------------------------------------------------------- */
static void send_keyboard_report(uint8_t modifier, uint8_t keycode)
{
    keyboard_report_t report;
    memset(&report, 0, sizeof(report));
    report.modifier = modifier;
    report.keys[0] = keycode;
    
    /* Block until USB is ready and endpoint is free */
    while (!g_usb_ready) {
        usb_device_task();
    }
    while (!usb_hid_send_report((uint8_t*)&report, sizeof(report))) {
        usb_device_task();
    }
}

static void delay_ms(uint32_t ms)
{
    while (ms--) {
        /* Busy-wait ~1 ms at 48 MHz (CYCLES_PER_MS iterations, ~4 cycles each).
         * Also pump the USB task so the host can still talk to us. */
        for (volatile uint32_t i = 0; i < CYCLES_PER_MS; i++) {
            __asm__ __volatile__ (""); /* prevent loop from being optimized away */
        }
        usb_device_task();
        g_tick_ms++;
    }
}

/* -----------------------------------------------------------------------
 * Main
 * --------------------------------------------------------------------- */
int main(void)
{
    /*
     * WDT disable: The AT32UC3B1 WDT uses a two-write key sequence.
     * The first write must have KEY=0x55 and preserve the current value of all other bits!
     * The second write must have KEY=0xAA and the new value (EN=0).
     */
    volatile uint32_t *wdt_ctrl = (volatile uint32_t *)(&AVR32_WDT.ctrl);
    uint32_t current_ctrl = *wdt_ctrl & ~AVR32_WDT_CTRL_KEY_MASK;
    *wdt_ctrl = current_ctrl | (0x55ul << AVR32_WDT_CTRL_KEY_OFFSET);
    *wdt_ctrl = (current_ctrl & ~AVR32_WDT_CTRL_EN_MASK) | (0xAAul << AVR32_WDT_CTRL_KEY_OFFSET);

    /* --- 1. System clock (OSC0 -> PLL0 -> 48 MHz) ------------------- */
    AVR32_PM.OSCCTRL0.startup = AVR32_PM_OSCCTRL0_STARTUP_2048_RCOSC;
    AVR32_PM.OSCCTRL0.mode    = AVR32_PM_OSCCTRL0_MODE_CRYSTAL_G3;
    AVR32_PM.MCCTRL.osc0en    = 1;
    while (!AVR32_PM.POSCSR.osc0rdy);

    AVR32_PM.pll[0] = 0; /* Disable first */
    AVR32_PM.pll[0] = (0 << AVR32_PM_PLLOSC_OFFSET)
                    | (1 << AVR32_PM_PLLDIV_OFFSET)
                    | (7 << AVR32_PM_PLLMUL_OFFSET)
                    | (3 << AVR32_PM_PLLOPT_OFFSET) /* Wide bandwidth, divide by 2 */
                    | (63 << AVR32_PM_PLLCOUNT_OFFSET);
    AVR32_PM.pll[0] |= AVR32_PM_PLLEN_MASK;
    while (!AVR32_PM.POSCSR.lock0);

    AVR32_FLASHC.FCR.fws = 1;
    AVR32_PM.MCCTRL.mcsel = AVR32_PM_MCCTRL_MCSEL_PLL0;

    /* --- 2. GPIO init ----------------------------------------------- */
    gpio_out       (LED_PORT, LED_PIN);
    gpio_high      (LED_PORT, LED_PIN);   /* LED off (active low) */
    gpio_in_pullup (BTN_PORT, BTN_PIN);

    /* --- 3. USB init ------------------------------------------------ */
    usb_device_init();
    usb_device_register_callback(USB_EVENT_ENUMERATED, usb_device_enumerated_cb);
    usb_hid_register_out_callback(usb_hid_report_out_cb);
    usb_device_enable();

    /* --- 5. Payload Execution --------------------------------------- */
    
    /* Wait for USB Enumeration */
    while (!g_usb_ready) {
        usb_device_task();
    }
    
    /* Wait 3 seconds before injecting to ensure OS is ready */
    delay_ms(3000);

    /* GUI + R (Run dialog) */
    send_keyboard_report(MOD_LGUI, KEY_R);
    delay_ms(50);
    send_keyboard_report(0, 0); /* Release */
    
    delay_ms(500);

    /* Type 'notepad' */
    uint8_t payload[] = { KEY_N, KEY_O, KEY_T, KEY_E, KEY_P, KEY_A, KEY_D, KEY_ENTER };
    for (int i = 0; i < sizeof(payload); i++) {
        send_keyboard_report(0, payload[i]);
        delay_ms(30);
        send_keyboard_report(0, 0); /* Release */
        delay_ms(30);
    }

    /* --- 6. Main loop ----------------------------------------------- */
    while (1) {
        usb_device_task();
    }

    return 0;
}
